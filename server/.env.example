# ---- Database ----
# Postgres (production, on NL):
DATABASE_URL=postgresql+psycopg://vault67:CHANGE_ME@127.0.0.1:5432/vault67
# SQLite (local dev):
# DATABASE_URL=sqlite:///./vault67.db

# ---- Auth ----
SECRET_KEY=CHANGE_ME_LONG_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Public / uploads ----
PUBLIC_BASE_URL=https://vault67.ru
UPLOAD_DIR=/var/www/vault67/uploads
UPLOAD_URL_PREFIX=/uploads

# ---- Geocoder: nominatim | dadata | photon ----
GEOCODER=nominatim
DADATA_API_KEY=

# ---- Telegram (bot @Vault67_bot) ----
